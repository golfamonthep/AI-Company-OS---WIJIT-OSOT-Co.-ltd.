APP_NAME=ai-company-os
APP_ENV=production
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-production-domain.example

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_PROJECT_REF=replace-with-project-ref
DATABASE_URL=postgresql://user:password@host:5432/postgres

OPENAI_API_KEY=replace-with-openai-key
LOG_LEVEL=info

API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120
WORKFLOW_MAX_RETRIES=3
WORKFLOW_TIMEOUT_MS=120000
CONNECTOR_RATE_LIMIT_WINDOW_MS=60000
CONNECTOR_RATE_LIMIT_MAX_REQUESTS=30

DEPLOYMENT_TARGET=vercel
PORT=3000
